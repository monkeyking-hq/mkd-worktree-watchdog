<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.monkeyking.worktree-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/mkd-worktree-watchdog</string>
    <string>--human</string>
    <string>prune</string>
  </array>
  <!-- Twice daily (every 12 hours) -->
  <key>StartInterval</key>
  <integer>43200</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
