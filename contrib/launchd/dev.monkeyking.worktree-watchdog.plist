<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.monkeyking.worktree-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/mkd-worktree-watchdog</string>
    <string>--human</string>
    <string>prune</string>
  </array>
  <!-- Twice daily at 06:00 and 18:00 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/mkd-worktree-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mkd-worktree-watchdog.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
